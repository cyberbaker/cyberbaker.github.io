---
import { LINKEDIN_URL, SITE_TAGLINE, SITE_TITLE, TRACKS } from '../consts';
import Logo from './Logo.astro';

interface Props {
	// Overrides which nav item is highlighted, e.g. an article highlights its post type.
	section?: string;
}
const base = import.meta.env.BASE_URL;
const path = Astro.props.section ? `${base}${Astro.props.section}` : Astro.url.pathname;

const nav = [
	{ href: base, label: 'Home', match: (p: string) => p === base },
	{ href: `${base}${TRACKS.everyday.path}`, label: 'Everyday security', match: (p: string) => p.startsWith(`${base}${TRACKS.everyday.path}`) },
	{ href: `${base}${TRACKS['deep-dive'].path}`, label: 'Deep dives', match: (p: string) => p.startsWith(`${base}${TRACKS['deep-dive'].path}`) },
	{ href: `${base}blog/`, label: 'All posts', match: (p: string) => p.startsWith(`${base}blog`) },
	{ href: `${base}about/`, label: 'About', match: (p: string) => p.startsWith(`${base}about`) },
];
---

<header class="site-header">
	<div class="container masthead">
		<a class="brand" href={base}>
			<Logo />
			<span class="brand-text">
				<span class="brand-name">{SITE_TITLE}</span>
				<span class="brand-tagline">{SITE_TAGLINE}</span>
			</span>
		</a>
		<div class="utility">
			<a href={`${base}rss.xml`}>
				<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
					><path
						fill="currentColor"
						d="M2 1a1 1 0 0 0 0 2 11 11 0 0 1 11 11 1 1 0 1 0 2 0A13 13 0 0 0 2 1Zm0 4.5a1 1 0 0 0 0 2A6.5 6.5 0 0 1 8.5 14a1 1 0 1 0 2 0A8.5 8.5 0 0 0 2 5.5ZM3.5 11a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"
					></path></svg
				>
				RSS
			</a>
			{
				LINKEDIN_URL && (
					<a href={LINKEDIN_URL} target="_blank" rel="noopener">
						<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
							<path
								fill="currentColor"
								d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
							></path>
						</svg>
						LinkedIn
					</a>
				)
			}
		</div>
	</div>
	<nav class="primary-nav" aria-label="Main">
		<ul class="container">
			{
				nav.map((item) => (
					<li>
						<a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		background: var(--navy-900);
		color: #fff;
		border-bottom: 4px solid var(--teal-600);
	}
	.masthead {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		color: #fff;
		text-decoration: none;
	}
	.brand:hover {
		color: #fff;
	}
	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.2;
	}
	.brand-name {
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.brand-tagline {
		font-size: 0.8125rem;
		color: #b7c6d6;
	}
	.utility {
		display: flex;
		gap: 1.25rem;
		font-size: 0.875rem;
	}
	.utility a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: #d5e0ea;
		text-decoration: none;
	}
	.utility a:hover {
		color: #fff;
		text-decoration: underline;
	}
	.primary-nav {
		background: var(--navy-800);
		border-top: 1px solid var(--navy-700);
	}
	.primary-nav ul {
		display: flex;
		gap: 0.25rem;
		list-style: none;
		margin: 0 auto;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.primary-nav a {
		display: block;
		padding: 0.8rem 0.9rem;
		color: #e8eef4;
		font-weight: 500;
		font-size: 0.9375rem;
		text-decoration: none;
		white-space: nowrap;
		border-bottom: 4px solid transparent;
	}
	.primary-nav li:first-child a {
		padding-left: 0;
	}
	.primary-nav a:hover {
		color: #fff;
		border-bottom-color: var(--line-strong);
	}
	.primary-nav a[aria-current='page'] {
		color: #fff;
		border-bottom-color: var(--amber-400);
	}
	@media (max-width: 640px) {
		.primary-nav ul {
			flex-wrap: wrap;
			column-gap: 0;
			overflow: visible;
		}
		.primary-nav a,
		.primary-nav li:first-child a {
			padding: 0.55rem 0.9rem 0.45rem 0;
			font-size: 0.875rem;
		}
		.brand-tagline {
			display: none;
		}
		.utility a span,
		.utility {
			font-size: 0;
			gap: 1rem;
		}
		.utility svg {
			width: 20px;
			height: 20px;
		}
	}
</style>
