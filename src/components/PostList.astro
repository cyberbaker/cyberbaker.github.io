---
import type { CollectionEntry } from 'astro:content';
import { TRACK_LABELS } from '../consts';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post) => (
			<li>
				<a href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>
					<p class="meta">
						<FormattedDate date={post.data.pubDate} />
						{post.data.track && (
							<span class:list={['track', post.data.track]}>{TRACK_LABELS[post.data.track]}</span>
						)}
					</p>
					<h3 class="title">{post.data.title}</h3>
					<p class="description">{post.data.description}</p>
				</a>
			</li>
		))
	}
</ul>

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	li a {
		display: block;
		padding: 1.25em 0;
		text-decoration: none;
		color: inherit;
	}
	.meta {
		margin: 0;
		font-size: 0.8em;
		color: rgb(var(--gray));
		display: flex;
		gap: 0.75em;
		align-items: center;
	}
	.title {
		margin: 0.25em 0;
		font-size: 1.35em;
		color: rgb(var(--black));
	}
	li a:hover .title {
		color: var(--accent);
	}
	.description {
		margin: 0;
		font-size: 0.9em;
	}
</style>
