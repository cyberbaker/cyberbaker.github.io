---
import { AUTHOR_NAME, LINKEDIN_URL, SITE_DESCRIPTION, SITE_TITLE, TRACKS } from '../consts';
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div class="about">
			<a class="brand" href={base}><Logo size={34} /> {SITE_TITLE}</a>
			<p>{SITE_DESCRIPTION}</p>
		</div>
		<nav aria-label="Sections">
			<h2>Sections</h2>
			<ul>
				<li><a href={`${base}${TRACKS.everyday.path}`}>{TRACKS.everyday.label}</a></li>
				<li><a href={`${base}${TRACKS['deep-dive'].path}`}>Deep dives</a></li>
				<li><a href={`${base}blog/`}>All posts</a></li>
				<li><a href={`${base}about/`}>About</a></li>
			</ul>
		</nav>
		<div>
			<h2>Follow</h2>
			<ul>
				{LINKEDIN_URL && <li><a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a></li>}
				<li><a href={`${base}rss.xml`}>RSS feed</a></li>
			</ul>
		</div>
	</div>
	<div class="container legal">
		<p>&copy; {year} {AUTHOR_NAME}. Views expressed are the author's own and do not represent any employer.</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		background: var(--navy-900);
		color: #c5d2de;
		font-size: 0.9375rem;
		border-top: 4px solid var(--teal-600);
	}
	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 2rem;
		padding-block: 2.5rem 2rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: #fff;
		font-weight: 700;
		font-size: 1.125rem;
		text-decoration: none;
		margin-bottom: 0.75rem;
	}
	.about p {
		max-width: 32rem;
		margin: 0;
	}
	h2 {
		color: #fff;
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 0.75rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li + li {
		margin-top: 0.4rem;
	}
	a {
		color: #fff;
	}
	a:hover {
		color: #fff;
	}
	.legal {
		border-top: 1px solid var(--navy-700);
		padding-block: 1.25rem;
		font-size: 0.8125rem;
		color: #9fb0c1;
	}
	.legal p {
		margin: 0;
	}
	@media (max-width: 720px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
		}
		.about {
			grid-column: 1 / -1;
		}
	}
</style>
