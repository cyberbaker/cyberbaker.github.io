---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPublishedPosts, type Post, relatedPosts } from '../../posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, related: relatedPosts(posts, post) },
	}));
}

const { post, related } = Astro.props as { post: Post; related: Post[] };
const { Content, headings } = await render(post);
---

<BlogPost post={post} headings={headings} related={related}>
	<Content />
</BlogPost>
