---
// Page shell shared by every page: head tags, skip link, header, footer.
import type { ComponentProps } from 'astro/types';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Props = ComponentProps<typeof BaseHead> & { section?: string };
const { section, ...head } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
	<head>
		<BaseHead {...head} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to main content</a>
		<Header section={section} />
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	body {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	main {
		flex: 1;
	}
</style>
